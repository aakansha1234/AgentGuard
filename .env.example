# AgentGuard settings. Copy to .env and export, or set in your shell. No secrets here.

# Where the dashboard, API and MCP gateway listen.
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8787

# Behind an HTTPS proxy (e.g. exe.dev): listen on all interfaces and set the public address.
# AGENTGUARD_HOST=0.0.0.0
# AGENTGUARD_PUBLIC_URL=https://your-vm.exe.xyz:8787

# Operator token: the bootstrap admin for the dashboard and API.
# Leave empty to have one generated and stored in .agentguard/operator_token (mode 0600).
# Add people with `agentguard user add NAME --role admin|approver|viewer`.
AGENTGUARD_OPERATOR_TOKEN=
AGENTGUARD_OPERATOR_NAME=operator

# Storage and policy.
AGENTGUARD_DATA_DIR=.agentguard
AGENTGUARD_POLICY=policies/default.yaml

# Live agent: Claude Code, launched headless with only AgentGuard's tools.
# Uses your existing `claude` login, or ANTHROPIC_API_KEY if set.
AGENTGUARD_CLAUDE_BIN=claude
AGENTGUARD_CLAUDE_MODEL=claude-opus-5-5

# Your MCP servers (see upstreams.example.yaml). Their credentials go below as plain
# variables and are referenced as ${VAR} in that file; agents never see them.
# AGENTGUARD_UPSTREAMS=upstreams.yaml
# CLOUDFLARE_FIREWALL_TOKEN=          # for the example Cloudflare firewall upstream
# The four mock SOC tools behind the demo scenarios. Set off for real deployments.
AGENTGUARD_DEMO_TOOLS=on

# Single sign-on through a reverse proxy that sends the signed-in email in a header.
# AGENTGUARD_AUTH_HEADER=X-ExeDev-Email
# AGENTGUARD_TRUSTED_PROXIES=          # optional CIDRs; default: any non-loopback peer

# Alerts when a human is needed: a Slack incoming-webhook URL (a secret).
# AGENTGUARD_NOTIFY_WEBHOOK=
# AGENTGUARD_NOTIFY_FORMAT=slack       # or json

# Who reviews outbound posts:
#   jev    TypeSafe Jev       needs TYPESAFE_API_KEY
#   clef   Cloudflare Clef    needs CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN (Workers AI Read)
#   human  no model; every reviewed action waits for your approval
# Required: there is no default. If it's unset, or the chosen mode's key is missing,
# AgentGuard refuses to start. It never falls back to another mode.
AGENTGUARD_REVIEWER=human
# TYPESAFE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
